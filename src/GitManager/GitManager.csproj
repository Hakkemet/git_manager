<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>GitManager</AssemblyName>
    <RootNamespace>GitManager</RootNamespace>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <EmbeddedResource Include="Locales\en_US.json" />
    <EmbeddedResource Include="Locales\pt_BR.json" />
    <None Include="Locales\en_US.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Locales\pt_BR.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
