<Window x:Class="GitManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="GitManager — Biblioteca de Repositórios GitHub (.zip)"
        Width="1360" Height="800"
        MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra Superior / Header -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + Título -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#1E1B4B" BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="1.5" Margin="0,0,14,0">
                        <TextBlock Text="📦" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="GitManager" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Border Background="#1E293B" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="AppVersionBadge" Text="v1.0.0 • Portátil (.zip)" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Biblioteca automática de repositórios GitHub salvos e versionados exclusivamente em arquivos .zip"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Ações Globais -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📂 Abrir GitManagerLibrary" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="OpenLibraryRoot_Click"
                            ToolTip="Abre a pasta principal onde todas as pastas de repositórios e versões .zip ficam salvas"/>
                    <Button x:Name="SyncAllBtn" Content="🔄 Atualizar Todos Agora" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="SyncAll_Click"/>
                    <Button Content="⚙️ Configurações" Style="{StaticResource SecondaryButton}" Click="OpenSettings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barra de Adição Rápida + Categoria + Ordenação + Filtro -->
        <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="155"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="185"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Input de URL do GitHub -->
                <Grid Grid.Column="0">
                    <TextBox x:Name="RepoUrlInput" Style="{StaticResource ModernTextBox}"
                             KeyDown="RepoUrlInput_KeyDown"
                             TextChanged="RepoUrlInput_TextChanged"/>
                    <TextBlock x:Name="RepoUrlPlaceholder"
                               Text="Cole a URL do GitHub (ex: https://github.com/usuario/repo)..."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12.5"
                               Margin="14,0,14,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>

                <!-- Categoria ao Adicionar -->
                <ComboBox Grid.Column="1" x:Name="NewRepoCategoryCombo"
                          IsEditable="True"
                          Text="Geral"
                          FontSize="12.5"
                          Padding="10,7"
                          Margin="8,0,0,0"
                          VerticalContentAlignment="Center"
                          ToolTip="Escolha ou digite uma nova categoria para classificar o repositório"/>

                <Button Grid.Column="2" x:Name="AddRepoBtn" Content="➕ Adicionar"
                        Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="AddRepo_Click"/>

                <!-- Filtro por Categoria -->
                <ComboBox Grid.Column="4" x:Name="CategoryFilterCombo"
                          FontSize="12.5"
                          Padding="10,7"
                          Margin="0,0,8,0"
                          VerticalContentAlignment="Center"
                          SelectionChanged="CategoryFilterCombo_SelectionChanged"
                          ToolTip="Filtrar cards por categoria"/>

                <!-- Ordenação (Recentes, Estrelas, A-Z, Z-A, Tamanho Maior/Menor) -->
                <ComboBox Grid.Column="5" x:Name="SortFilterCombo"
                          FontSize="12.5"
                          Padding="10,7"
                          Margin="0,0,8,0"
                          VerticalContentAlignment="Center"
                          SelectionChanged="SortFilterCombo_SelectionChanged"
                          ToolTip="Ordenar repositórios por Recentes, Estrelas, A-Z, Z-A ou Tamanho">
                    <ComboBoxItem Content="🕒 Recentes" IsSelected="True"/>
                    <ComboBoxItem Content="⭐ Estrelas"/>
                    <ComboBoxItem Content="🔤 Nome (A-Z)"/>
                    <ComboBoxItem Content="🔤 Nome (Z-A)"/>
                    <ComboBoxItem Content="📦 Tamanho (Maior)"/>
                    <ComboBoxItem Content="📦 Tamanho (Menor)"/>
                </ComboBox>

                <!-- Filtro de busca por texto -->
                <Grid Grid.Column="6">
                    <TextBox x:Name="SearchInput" Style="{StaticResource ModernTextBox}"
                             TextChanged="SearchInput_TextChanged"/>
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="🔍 Buscar nome, categoria ou descrição..."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12.5"
                               Margin="14,0,14,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Grade de Cards de Repositórios (5 colunas = 20% da largura cada) -->
        <Grid Grid.Row="2">
            <!-- Estado Vazio -->
            <Border x:Name="EmptyStatePanel" Visibility="Collapsed"
                    Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="14"
                    MaxWidth="560" MaxHeight="270" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📦" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Sua biblioteca GitManagerLibrary está pronta!" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Adicione a URL de qualquer repositório do GitHub no campo acima e escolha sua categoria. O aplicativo baixará o pacote .zip automaticamente para a pasta do repositório e manterá todas as versões salvas."
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- ScrollViewer com Grid de 5 Colunas (20% por card) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14">
                <ItemsControl x:Name="ReposItemsControl" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgCardBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="6"
                                    VerticalAlignment="Stretch">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Linha 0: TAG DE CATEGORIA DESTACADA (Clicável) + Botão Excluir -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button HorizontalAlignment="Left"
                                                Cursor="Hand"
                                                Tag="{Binding}"
                                                Click="ChangeCategoryBadge_Click"
                                                ToolTip="Clique para alterar ou criar uma nova categoria para este repositório"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                Padding="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{Binding CategoryBgColor}"
                                                            BorderBrush="{Binding CategoryBorderColor}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="6"
                                                            Padding="9,3">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CategoryDisplay}"
                                                                       Foreground="{Binding CategoryTextColor}"
                                                                       FontSize="10.5"
                                                                       FontWeight="Bold"/>
                                                            <TextBlock Text=" ▾"
                                                                       Foreground="{Binding CategoryTextColor}"
                                                                       FontSize="10"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button Grid.Column="1" Content="🗑️" Style="{StaticResource SecondaryButton}"
                                                Padding="6,3" FontSize="11" Margin="6,0,0,0"
                                                Tag="{Binding}" Click="RemoveRepo_Click"
                                                ToolTip="Remover da biblioteca"/>
                                    </Grid>

                                    <!-- Linha 1: Nome do Repositório Clicável (Abre Modal com Detalhes e Notas) -->
                                    <Button Grid.Row="1"
                                            Tag="{Binding}"
                                            Click="OpenRepoDetails_Click"
                                            Cursor="Hand"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,6"
                                            ToolTip="Clique para abrir todos os detalhes e notas de atualização deste repositório">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="repoTitleText"
                                                               Text="{Binding FullName}"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="200"/>
                                                    <TextBlock x:Name="infoIcon"
                                                               Text=" ℹ️"
                                                               FontSize="11.5"
                                                               Opacity="0.7"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="repoTitleText" Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                        <Setter TargetName="repoTitleText" Property="TextDecorations" Value="Underline"/>
                                                        <Setter TargetName="infoIcon" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Linha 2: Badges Compactas (Linguagem, Tag, Estrelas, Status) -->
                                    <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                                                CornerRadius="5" Padding="6,1.5" Margin="0,0,5,4">
                                            <TextBlock Text="{Binding Language}" FontSize="10.5" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold"/>
                                        </Border>

                                        <Border Background="#1E1B4B" BorderBrush="#4338CA" BorderThickness="1"
                                                CornerRadius="5" Padding="6,1.5" Margin="0,0,5,4">
                                            <TextBlock Text="{Binding LatestVersionTag}" FontSize="10.5" Foreground="#A5B4FC" FontWeight="SemiBold"
                                                       MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <Border Background="#0F172A" CornerRadius="5" Padding="6,1.5" Margin="0,0,5,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="★ " Foreground="#FBBF24" FontSize="10.5"/>
                                                <TextBlock Text="{Binding StarsCount}" Foreground="#E2E8F0" FontSize="10.5"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="{Binding StatusMessage}" FontSize="10.5" Foreground="#34D399"
                                                   FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,0,4"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}"/>
                                    </WrapPanel>

                                    <!-- Linha 3: Descrição compacta -->
                                    <TextBlock Grid.Row="3" Text="{Binding Description}"
                                               FontSize="11.5" Foreground="#CBD5E1"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               Height="34" MaxHeight="34"
                                               ToolTip="{Binding Description}"
                                               Margin="0,0,0,10"/>

                                    <!-- Linha 4: Seletor de Versão (.zip) Compacto -->
                                    <Border Grid.Row="4" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1"
                                            CornerRadius="7" Padding="8,6" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="📦 Versão (.zip):" FontSize="10.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedVersion.FormattedSize, FallbackValue=''}"
                                                           FontSize="10.5" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ComboBox ItemsSource="{Binding Versions}"
                                                      SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayTitle"
                                                      FontSize="11" Padding="6,3"
                                                      HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Linha 5: Botões de Ação Compactos -->
                                    <StackPanel Grid.Row="5">
                                        <Button Content="🚀 Criar Projeto" Style="{StaticResource SuccessButton}"
                                                Padding="10,6" FontSize="12" HorizontalAlignment="Stretch"
                                                Tag="{Binding}" Click="CreateProject_Click"
                                                Margin="0,0,0,6"
                                                ToolTip="Extrai a versão .zip selecionada em uma pasta de projeto escolhida por você"/>

                                        <UniformGrid Columns="3">
                                            <Button Content="🔄 Baixar" Style="{StaticResource SecondaryButton}"
                                                    Padding="4,5" FontSize="11" Margin="0,0,3,0"
                                                    Tag="{Binding}" Click="SyncSingleRepo_Click"
                                                    ToolTip="Verificar atualizações e baixar novo .zip"/>
                                            <Button Content="📂 .zips" Style="{StaticResource SecondaryButton}"
                                                    Padding="4,5" FontSize="11" Margin="2,0,2,0"
                                                    Tag="{Binding}" Click="OpenRepoFolder_Click"
                                                    ToolTip="Abrir pasta deste repositório com os arquivos .zip"/>
                                            <Button Content="🌐 Web" Style="{StaticResource SecondaryButton}"
                                                    Padding="4,5" FontSize="11" Margin="3,0,0,0"
                                                    Tag="{Binding}" Click="OpenGitHubUrl_Click"
                                                    ToolTip="Abrir repositório original no GitHub"/>
                                        </UniformGrid>

                                        <TextBlock Text="{Binding LastCheckedText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Right" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Barra de Status Inferior -->
        <Border Grid.Row="3" Background="{StaticResource BgSecondaryBrush}" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatusText"
                           Text="Pronto • Monitoramento em segundo plano ativo na bandeja do Windows"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="FooterLibraryPathText"
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
