<Window x:Class="GitManager.RepositoryDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:GitManager.Services"
        Title="GitManager"
        Width="780" Height="620"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Linha 0: Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                    <!-- Tag de Categoria -->
                    <Border Background="{Binding CategoryBgColor}"
                            BorderBrush="{Binding CategoryBorderColor}"
                            BorderThickness="1.5"
                            CornerRadius="6"
                            Padding="10,3"
                            Margin="0,0,10,0">
                        <TextBlock Text="{Binding CategoryDisplay}"
                                   Foreground="{Binding CategoryTextColor}"
                                   FontSize="11.5"
                                   FontWeight="Bold"/>
                    </Border>

                    <!-- Linguagem -->
                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                            CornerRadius="6" Padding="8,2.5" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Language}" FontSize="11.5" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Tag / Branch -->
                    <Border Background="#1E1B4B" BorderBrush="#4338CA" BorderThickness="1"
                            CornerRadius="6" Padding="8,2.5" Margin="0,0,8,0">
                        <TextBlock Text="{Binding LatestVersionTag}" FontSize="11.5" Foreground="#A5B4FC" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Estrelas -->
                    <Border Background="#0F172A" CornerRadius="6" Padding="8,2.5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="★ " Foreground="#FBBF24" FontSize="11.5"/>
                            <TextBlock Text="{Binding StarsCount}" Foreground="#E2E8F0" FontSize="11.5"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#34D399"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                </WrapPanel>

                <TextBlock Text="{Binding FullName}" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding RepoUrl}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Botões do Topo -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetailsOpenZipsBtn]}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OpenFolder_Click"/>
                <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetailsOpenGitHubBtn]}"
                        Style="{StaticResource SecondaryButton}" Click="OpenGitHub_Click"/>
            </StackPanel>
        </Grid>

        <!-- Linha 1: Descrição Completa -->
        <Border Grid.Row="1" Background="#111827" BorderBrush="#1E293B" BorderThickness="1"
                CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetailsDescriptionHeader]}"
                           FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding Description}" FontSize="13.5" Foreground="#E2E8F0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Linha 2: Seletor de Versão (.zip) -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1"
                CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetailsSelectedVersionLabel]}"
                           FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Versions}"
                          SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                          DisplayMemberPath="DisplayTitle"
                          FontSize="12.5" Padding="8,4"
                          VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding SelectedVersion.FormattedSize, FallbackValue=''}"
                           FontSize="12.5" Foreground="{StaticResource AccentCyanBrush}"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>

                <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastUpdatedText}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding LastCheckedText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Linha 3: Notas de Update -->
        <Border Grid.Row="3" Background="#090D16" BorderBrush="#1E293B" BorderThickness="1"
                CornerRadius="10" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetailsNotesHeader]}"
                               FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedVersion.FileName, FallbackValue=''}"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </Grid>

                <TextBox Grid.Row="1"
                         Text="{Binding ActiveNotes, Mode=OneWay}"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#F1F5F9"
                         FontFamily="Consolas"
                         FontSize="12.5"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <!-- Linha 4: Rodapé de Ações do Modal -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="SyncModalBtn"
                    Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetailsSyncBtn]}"
                    Style="{StaticResource SecondaryButton}" Padding="14,9" Click="SyncRepo_Click"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetailsCreateProjectBtn]}"
                        Style="{StaticResource SuccessButton}" Padding="18,9" Margin="0,0,10,0" Click="CreateProject_Click"/>
                <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[CloseBtn]}"
                        Style="{StaticResource SecondaryButton}" Width="100" Padding="12,9" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
