<Window x:Class="GitManager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações - GitManager"
        Width="540" Height="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Configurações do GitManager" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Ajuste o comportamento em segundo plano, pasta de bibliotecas .zip e auto-atualização."
                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Conteúdo -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Pasta da biblioteca -->
                <TextBlock Text="Pasta da Biblioteca (GitManagerLibrary):" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LibraryPathBox" Style="{StaticResource ModernTextBox}" IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="Escolher..." Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseLibraryFolder_Click"/>
                </Grid>

                <!-- Intervalo de verificação -->
                <TextBlock Text="Intervalo de verificação automática (minutos):" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBox x:Name="IntervalBox" Style="{StaticResource ModernTextBox}" Width="120" HorizontalAlignment="Left"/>
                    <Button x:Name="CheckAppUpdateBtn" Content="🔄 Verificar Atualização do App"
                            Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Click="CheckAppUpdate_Click"/>
                </StackPanel>

                <!-- Opções do Windows -->
                <CheckBox x:Name="StartWithWindowsCheck"
                          Content="Iniciar automaticamente com o Windows (auto-registro na bandeja)"
                          Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,10"/>

                <CheckBox x:Name="MinimizeToTrayCheck"
                          Content="Manter aberto em segundo plano na bandeja ao fechar a janela (X)"
                          Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,18"/>

                <Separator Background="#1E293B" Margin="0,0,0,14"/>

                <!-- Token opcional do GitHub -->
                <TextBlock Text="GitHub Personal Access Token (Opcional - evita limite de requisições e permite repos privados):"
                           FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                <TextBox x:Name="GitHubTokenBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,8"/>
                <TextBlock x:Name="UpdateStatusText" Text="" FontSize="12" Foreground="{StaticResource AccentCyanBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Rodapé -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Salvar Configurações" Style="{StaticResource PrimaryButton}" Width="170" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
