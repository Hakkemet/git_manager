<Window x:Class="GitManager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:GitManager.Services"
        Title="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SettingsTitle]}"
        Width="540" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SettingsHeader]}"
                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SettingsSubtitle]}"
                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Idioma da Interface -->
                <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SettingsLanguageLabel]}"
                           FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                <ComboBox x:Name="LanguageComboBox"
                          Width="240"
                          HorizontalAlignment="Left"
                          FontSize="13"
                          Padding="10,7"
                          Margin="0,0,0,14">
                    <ComboBoxItem Content="🇺🇸 English (en_US)" Tag="en_US"/>
                    <ComboBoxItem Content="🇧🇷 Português - Brasil (pt_BR)" Tag="pt_BR"/>
                </ComboBox>

                <!-- Pasta da biblioteca -->
                <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SettingsLibraryPathLabel]}"
                           FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LibraryPathBox" Style="{StaticResource ModernTextBox}" IsReadOnly="True"/>
                    <Button Grid.Column="1"
                            Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[BrowseBtn]}"
                            Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseLibraryFolder_Click"/>
                </Grid>

                <!-- Programação de atualização diária -->
                <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SettingsIntervalLabel]}"
                           FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,9">
                        <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SettingsDailyScheduleInfo]}"
                                   FontSize="12.5" Foreground="#94A3B8" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="1" x:Name="CheckAppUpdateBtn"
                            Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SettingsCheckAppUpdateBtn]}"
                            Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" VerticalAlignment="Center" Click="CheckAppUpdate_Click"/>
                </Grid>

                <!-- Opções do Windows -->
                <CheckBox x:Name="StartWithWindowsCheck"
                          Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SettingsStartWithWindows]}"
                          Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,10"/>

                <CheckBox x:Name="MinimizeToTrayCheck"
                          Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SettingsMinimizeToTray]}"
                          Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,18"/>

                <Separator Background="#1E293B" Margin="0,0,0,14"/>

                <!-- Token opcional do GitHub -->
                <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SettingsGitHubTokenLabel]}"
                           FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6" TextWrapping="Wrap"/>
                <TextBox x:Name="GitHubTokenBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,8"/>
                <TextBlock x:Name="UpdateStatusText" Text="" FontSize="12" Foreground="{StaticResource AccentCyanBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[CancelBtn]}"
                    Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SettingsSaveBtn]}"
                    Style="{StaticResource PrimaryButton}" Width="170" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
